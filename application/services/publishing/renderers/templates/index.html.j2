<!DOCTYPE html>
<html lang="en" class="scroll-smooth antialiased bg-themeBg text-gray-300 selection:bg-brand-500/30 selection:text-brand-300 overflow-x-clip">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Strata Enterprise Audit: {{ model.system_context.project_name }}</title>

    <!-- Core Libraries -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Mermaid Initialization -->
    <script type="module">
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
        mermaid.initialize({
            startOnLoad: true,
            theme: 'base',
            themeVariables: {
                background: '#0a0a0a', primaryColor: '#2563eb', primaryBorderColor: '#3b82f6',
                primaryTextColor: '#fff', secondaryColor: '#1a1a1a', secondaryBorderColor: '#333',
                tertiaryColor: '#111', tertiaryBorderColor: '#262626', fontFamily: 'Inter',
                edgeLabelBackground: '#050505', lineColor: '#555'
            }
        });
    </script>

    <!-- Tailwind Config -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
                    colors: {
                        brand: { 400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 900: '#1e3a8a' },
                        surface: { 
                            50: 'hsl(var(--bg-surface-50) / <alpha-value>)', 
                            100: 'hsl(var(--bg-surface-100) / <alpha-value>)', 
                            200: 'hsl(var(--bg-surface-200) / <alpha-value>)' 
                        },
                        borderline: 'hsl(var(--border-color) / <alpha-value>)',
                        themeBg: 'hsl(var(--bg-main) / <alpha-value>)',
                        themeText: 'hsl(var(--text-main) / <alpha-value>)',
                        themeHeading: 'hsl(var(--text-heading) / <alpha-value>)',
                        themeMuted: 'hsl(var(--text-muted) / <alpha-value>)',
                        themeDim: 'hsl(var(--text-dim) / <alpha-value>)',
                        
                        // Override standard text colors for seamless dark/light modes
                        white: 'hsl(var(--text-heading) / <alpha-value>)',
                        gray: {
                            100: 'hsl(var(--text-main) / <alpha-value>)',
                            200: 'hsl(var(--text-main) / <alpha-value>)',
                            300: 'hsl(var(--text-main) / <alpha-value>)',
                            400: 'hsl(var(--text-muted) / <alpha-value>)',
                            500: 'hsl(var(--text-dim) / <alpha-value>)',
                            600: 'hsl(var(--text-dim) / <alpha-value>)',
                            700: 'hsl(var(--text-dim) / <alpha-value>)',
                            800: 'hsl(var(--text-dim) / <alpha-value>)',
                            900: 'hsl(var(--text-dim) / <alpha-value>)'
                        }
                    },
                    boxShadow: { 'glow-brand': '0 0 20px rgba(59, 130, 246, 0.15)', 'glow-red': '0 0 20px rgba(239, 68, 68, 0.15)' }
                }
            }
        }
    </script>

    <style>
        :root {
            --bg-main: 240 10% 3.9%;
            --bg-surface-50: 240 5.9% 10%;
            --bg-surface-100: 240 5.9% 7%;
            --bg-surface-200: 240 10% 3.9%;
            --border-color: 240 5.9% 15%;
            --text-heading: 0 0% 100%;
            --text-main: 240 5% 84%;
            --text-muted: 240 5% 65%;
            --text-dim: 240 5% 45%;
        }

        body.light-theme {
            --bg-main: 210 20% 98%;
            --bg-surface-50: 220 14% 96%;
            --bg-surface-100: 0 0% 100%;
            --bg-surface-200: 220 13% 91%;
            --border-color: 220 13% 85%;
            --text-heading: 224 71.4% 4.1%;
            --text-main: 220 20% 22%;
            --text-muted: 220 15% 35%;
            --text-dim: 220 13% 45%;
        }

        body {
            background-color: hsl(var(--bg-main));
            color: hsl(var(--text-main));
        }

        /* Enterprise Styling & Overrides */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: hsl(var(--bg-main)); }
        ::-webkit-scrollbar-thumb { background: hsl(var(--border-color)); border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #404040; }

        .doc-section { scroll-margin-top: 6rem; border-bottom: 1px solid var(--border-color); padding-bottom: 6rem; margin-bottom: 6rem; }
        .doc-section:last-child { border-bottom: none; margin-bottom: 0; }

        .data-table th { border-bottom: 1px solid var(--border-color); padding: 16px 20px; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); font-weight: 600; text-align: left; background: var(--bg-surface-200); }
        .data-table td { border-bottom: 1px solid var(--border-color); padding: 16px 20px; font-size: 0.875rem; color: var(--text-main); }
        .data-table tr:hover td { background: var(--bg-surface-50); color: var(--text-heading); }

        .code-block { background: var(--bg-surface-200); border: 1px solid var(--border-color); border-radius: 0.5rem; padding: 1.25rem; font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; line-height: 1.6; overflow-x: auto; }
        .code-line-num { color: var(--text-dim); display: inline-block; width: 2.5rem; user-select: none; border-right: 1px solid var(--border-color); margin-right: 1rem; }

        .bg-gradient-mesh { background-image: radial-gradient(at 100% 0%, rgba(37, 99, 235, 0.08) 0px, transparent 50%), radial-gradient(at 0% 100%, rgba(239, 68, 68, 0.05) 0px, transparent 50%); }
    </style>
</head>

<body class="bg-gradient-mesh bg-themeBg overflow-x-clip text-themeText" x-data="{
    activeSection: 'exec',
    scrolled: false,
    darkMode: true,
    init() {
        window.addEventListener('scroll', () => { this.scrolled = window.scrollY > 20; });
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => { if (entry.isIntersecting) this.activeSection = entry.target.id; });
        }, { rootMargin: '-20% 0px -80% 0px' });
        document.querySelectorAll('.doc-section').forEach(section => observer.observe(section));
    }
}">

    <!-- Top Navigation Bar -->
    <nav :class="scrolled ? 'bg-themeBg/90 backdrop-blur-xl border-borderline shadow-xl' : 'bg-transparent border-transparent'" class="fixed top-0 w-full border-b z-50 transition-all duration-300 px-6 lg:px-10 py-4 flex items-center justify-between">
        <div class="flex items-center gap-5">
            <div class="w-7 h-7 bg-gradient-to-br from-brand-400 to-brand-600 rounded flex items-center justify-center shadow-glow-brand">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <span class="font-extrabold text-themeHeading tracking-tight text-lg">STRATA <span class="font-medium text-themeDim">INTELLIGENCE</span></span>
            <div class="h-4 w-px bg-borderline hidden md:block"></div>
            <span class="hidden md:flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-surface-50 border border-borderline text-themeMuted">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Target: {{ model.system_context.project_name }}
            </span>
        </div>
        <div class="flex items-center gap-6">
            <div class="hidden lg:flex flex-col items-end">
                <span class="text-xs font-bold text-themeHeading">Analysis Generated</span>
                <span class="text-xs font-mono text-themeDim">{{ current_date | default('Current Export Date') }}</span>
            </div>
            <button @click="darkMode = !darkMode; document.body.classList.toggle('light-theme', !darkMode); window.dispatchEvent(new CustomEvent('theme-changed'))" 
                    class="p-2 rounded-lg border border-borderline hover:bg-surface-50 text-themeMuted hover:text-themeHeading transition-all shadow-glow-brand"
                    title="Toggle Theme">
                <!-- Sun Icon -->
                <svg x-show="darkMode" class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.364l-.707-.707M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <!-- Moon Icon -->
                <svg x-show="!darkMode" class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display: none;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                </svg>
            </button>
        </div>
    </nav>

    <!-- Main Layout -->
    <div class="flex max-w-[120rem] mx-auto pt-24">

        <!-- Sticky Left Index (Table of Contents) -->
        <aside class="hidden xl:block w-64 self-start shrink-0 px-6 py-8 sticky top-24 h-[calc(100vh-6rem)] overflow-y-auto border-r border-borderline">
            <div class="mb-10">
                <h3 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-4">Project Meta</h3>
                <div class="grid grid-cols-1 gap-4 text-xs font-mono text-gray-400">
                    <div class="border-b border-borderline pb-2">
                        <div class="text-gray-500 uppercase text-[10px] tracking-wider">PHP Version</div>
                        <div class="text-white font-bold mt-0.5">Legacy PHP</div>
                    </div>
                    <div class="border-b border-borderline pb-2">
                        <div class="text-gray-500 uppercase text-[10px] tracking-wider">Framework</div>
                        <div class="text-white font-bold mt-0.5 break-words">{{ model.system_context.framework | default('Unknown') }}</div>
                    </div>
                    <div class="border-b border-borderline pb-2">
                        <div class="text-gray-500 uppercase text-[10px] tracking-wider">Total Files</div>
                        <div class="text-white font-bold mt-0.5">{{ "{:,}".format(model.system_context.total_files) }}</div>
                    </div>
                    <div class="border-b border-borderline pb-2">
                        <div class="text-gray-500 uppercase text-[10px] tracking-wider">Lines of Code</div>
                        <div class="text-white font-bold mt-0.5">{{ "{:,}".format(model.system_context.lines_of_code) }}</div>
                    </div>
                </div>
            </div>

            <p class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-6">Document Index</p>
            <ul class="space-y-1 text-sm font-medium text-gray-400">
                <template x-for="item in [
                    { id: 'exec', name: '1. Executive Command' },
                    { id: 'discovery', name: '2. Architectural Discovery' },
                    { id: 'boundary', name: '3. Boundary Intelligence' },
                    { id: 'database', name: '4. Database Intelligence' },
                    { id: 'global_state', name: '5. Runtime & Global State' },
                    { id: 'legacy', name: '6. Legacy PHP Intelligence' },
                    { id: 'risks', name: '7. Structural Risk Audit' },
                    { id: 'playbooks', name: '8. Extraction Playbooks' }
                ]">
                    <li>
                        <a :href="'#' + item.id"
                           :class="activeSection === item.id ? 'text-brand-500 bg-brand-500/10 border-brand-500 font-semibold' : 'border-transparent hover:text-white hover:bg-surface-50'"
                           class="block px-4 py-2.5 border-l-2 rounded-r transition-all"
                           x-text="item.name"></a>
                    </li>
                </template>
            </ul>
        </aside>

        <!-- Scrolling Document Content -->
        <main class="flex-1 px-6 md:px-12 lg:px-20 py-8 max-w-7xl">

            <!-- ==========================================
                 1. EXECUTIVE COMMAND
                 ========================================== -->
            <section id="exec" class="doc-section">
                <header class="mb-10">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded border border-brand-500/30 bg-brand-500/10 text-brand-400 text-xs font-mono font-bold mb-6">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        STRATEGIC MODERNIZATION COMMAND CENTER
                    </div>
                    <h1 class="text-5xl md:text-6xl font-extrabold text-white tracking-tighter mb-4 leading-tight">Software Architecture &<br><span class="text-transparent bg-clip-text bg-gradient-to-r from-gray-400 to-gray-600">Modernization Report</span></h1>
                    <p class="text-lg md:text-xl text-themeMuted leading-relaxed max-w-4xl">A comprehensive architectural evaluation of the <strong>{{ model.system_context.project_name }}</strong> codebase, evaluating technical debt, boundary segregation, coupling risk, and refactoring pathways.</p>
                </header>

                <!-- Top Row: Readiness & Strategy -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <!-- Gauge -->
                    <div class="bg-surface-100 border border-borderline p-6 rounded-2xl flex flex-col justify-center items-center relative overflow-hidden">
                        <div class="absolute top-0 w-full h-1 bg-gradient-to-r {% if model.system_context.overall_readiness > 60 %}from-emerald-500 to-brand-500{% elif model.system_context.overall_readiness > 30 %}from-amber-500 to-yellow-500{% else %}from-red-500 to-amber-500{% endif %}"></div>
                        <h2 class="text-4xl font-black text-brand-400 tracking-tighter mb-1">{{ model.system_context.overall_readiness }}%</h2>
                        <p class="text-xs text-gray-500 font-mono uppercase tracking-widest mb-4">Modernization Readiness</p>
                        <div class="w-full bg-surface-200 h-2 rounded-full overflow-hidden">
                            <div class="h-full bg-brand-500 rounded-full" style="width: {{ model.system_context.overall_readiness }}%;"></div>
                        </div>
                    </div>
                    
                    <!-- Project Meta -->
                    <div class="md:col-span-2 bg-surface-100 border border-borderline p-6 rounded-2xl flex flex-col justify-center">
                        <h4 class="text-xl font-bold text-white mb-2">{{ model.system_context.project_name }}</h4>
                        <p class="text-sm text-themeMuted mb-4 font-mono">{{ model.system_context.root_path | default('Not Specified') }}</p>
                        <div class="flex flex-wrap gap-3">
                            <span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-3 py-1 rounded text-xs font-mono font-bold">ERA: {{ model.system_context.php_era }}</span>
                            <span class="bg-brand-500/10 text-brand-400 border border-brand-500/20 px-3 py-1 rounded text-xs font-mono font-bold">FW: {{ model.system_context.framework }}</span>
                            <span class="bg-surface-50 text-gray-400 border border-borderline px-3 py-1 rounded text-xs font-mono font-bold">Status: {% if model.system_context.overall_readiness < 40 %}CRITICAL DEBT{% elif model.system_context.overall_readiness < 70 %}HIGH RISK{% else %}HEALTHY{% endif %}</span>
                        </div>
                    </div>
                </div>
 
                <!-- Radar & Scorecard Row -->
                {% if model.legacy_intelligence and model.legacy_intelligence.score_dimensions %}
                <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 mb-8">
                    <!-- Radar Card -->
                    <div class="lg:col-span-3 bg-surface-100 border border-borderline p-6 rounded-2xl flex flex-col">
                        <h4 class="text-xs font-bold uppercase tracking-widest text-brand-400 mb-4">Architecture Modernization Index</h4>
                        <div class="flex-1 w-full min-h-[320px] relative p-2">
                            <canvas id="radarChart"></canvas>
                        </div>
                    </div>
                    <!-- Scorecard Card -->
                    <div class="lg:col-span-2 bg-surface-100 border border-borderline p-6 rounded-2xl flex flex-col justify-between">
                        <div>
                            <h4 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-4">Dimension Scorecard</h4>
                            <div class="space-y-4 font-mono text-xs">
                                {% for label, key in [
                                    ('Security Posture', 'Security Score'),
                                    ('Database Layering', 'DB Layer Score'),
                                    ('Code Testability', 'Testability Score'),
                                    ('Namespace Adoption', 'Namespace Score'),
                                    ('Coupling Segregation', 'Coupling Score')
                                ] %}
                                {% set raw_val = model.legacy_intelligence.score_dimensions.get(key, 0.0) %}
                                {% set pct = (raw_val * 100) | round(1) %}
                                <div>
                                    <div class="flex justify-between mb-1.5">
                                        <span class="text-themeMuted font-bold">{{ label }}</span>
                                        <span class="text-white font-extrabold">{{ pct }}%</span>
                                    </div>
                                    <div class="w-full bg-surface-200 h-2 rounded-full overflow-hidden">
                                        <div class="h-full rounded-full {% if pct < 35 %}bg-red-500{% elif pct < 70 %}bg-amber-500{% else %}bg-emerald-500{% endif %}" style="width: {{ pct }}%;"></div>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="mt-6 pt-4 border-t border-borderline text-[10px] text-themeMuted font-mono">
                            Scores evaluate the project's internal codebase. External vendor packages are excluded.
                        </div>
                    </div>
                </div>
                {% endif %}

                <!-- KPI Bento Grid -->
                <div class="space-y-6 mb-12">
                    <div>
                        <h3 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-4">System Vitality</h3>
                        <div class="grid grid-cols-2 md:grid-cols-6 gap-4">
                            <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center">
                                <div class="text-2xl font-black text-white">{{ "{:,}".format(model.system_context.total_files) }}</div>
                                <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Total Files</div>
                            </div>
                            <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center">
                                <div class="text-2xl font-black text-white">{{ "{:,}".format(model.system_context.lines_of_code) }}</div>
                                <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Lines of Code</div>
                            </div>
                            <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center">
                                <div class="text-2xl font-black text-amber-500">{{ model.system_context.avg_complexity }}</div>
                                <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Avg Complexity</div>
                            </div>
                            <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center">
                                <div class="text-2xl font-black text-white">{{ "{:,}".format(model.system_context.total_classes) }}</div>
                                <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Total Classes</div>
                            </div>
                            <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center">
                                <div class="text-2xl font-black text-red-500">{{ "{:,}".format(model.system_context.connectivity) }}</div>
                                <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Connectivity</div>
                            </div>
                            <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center">
                                <div class="text-2xl font-black text-brand-500">{{ model.system_context.test_coverage }}</div>
                                <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Test Coverage</div>
                            </div>
                        </div>
                    </div>
                    
                    <div>
                        <h3 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-4">Architectural Footprint</h3>
                        <div class="grid grid-cols-2 md:grid-cols-6 gap-4">
                            {% set fp = model.system_context.architectural_footprint %}
                            <div class="bg-surface-100 border border-borderline p-4 rounded-xl flex items-center justify-between">
                                <span class="text-xs text-gray-400 font-medium">Models</span>
                                <span class="text-lg font-black text-white">{{ fp.get('Models', 0) }}</span>
                            </div>
                            <div class="bg-surface-100 border border-borderline p-4 rounded-xl flex items-center justify-between">
                                <span class="text-xs text-gray-400 font-medium">Controllers</span>
                                <span class="text-lg font-black text-white">{{ fp.get('Controllers', 0) }}</span>
                            </div>
                            <div class="bg-surface-100 border border-borderline p-4 rounded-xl flex items-center justify-between">
                                <span class="text-xs text-gray-400 font-medium">Views</span>
                                <span class="text-lg font-black text-white">{{ fp.get('Views', 0) }}</span>
                            </div>
                            <div class="bg-surface-100 border border-borderline p-4 rounded-xl flex items-center justify-between">
                                <span class="text-xs text-gray-400 font-medium">CLI Scripts</span>
                                <span class="text-lg font-black text-white">{{ fp.get('CLI_Scripts', 0) }}</span>
                            </div>
                            <div class="bg-surface-100 border border-borderline p-4 rounded-xl flex items-center justify-between">
                                <span class="text-xs text-gray-400 font-medium">Schemas</span>
                                <span class="text-lg font-black text-white">{{ fp.get('Schemas', 0) }}</span>
                            </div>
                            <div class="bg-surface-100 border border-borderline p-4 rounded-xl flex items-center justify-between">
                                <span class="text-xs text-gray-400 font-medium">Libraries</span>
                                <span class="text-lg font-black text-white">{{ fp.get('Vendor_Files', 0) }}</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- AI Narrative Full Width -->
                <div class="bg-surface-100 border border-brand-500/30 p-8 md:p-12 rounded-2xl shadow-2xl relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-64 h-64 bg-brand-500/10 rounded-full blur-3xl -mr-10 -mt-10 pointer-events-none"></div>
                    <div class="flex items-center gap-3 mb-8 pb-6 border-b border-borderline relative z-10">
                        <div class="w-10 h-10 rounded-full bg-brand-900/50 flex items-center justify-center border border-brand-500/30">
                            <svg class="w-5 h-5 text-brand-400" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zM9 9V5h2v4h4v2h-4v4H9v-4H5V9h4z"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-white font-bold text-xl tracking-tight">Architectural Advisory Synthesis</h3>
                            <p class="text-xs text-gray-500">AI-assisted evaluation of system mechanics, structural debt, and refactoring pathways.</p>
                        </div>
                    </div>
                    
                    <div class="space-y-10 relative z-10">
                        <!-- 1. Current Architectural State -->
                        <div>
                            <h4 class="text-sm font-bold uppercase tracking-widest text-brand-400 mb-4">Current Architectural State</h4>
                            <div class="text-base text-gray-300 space-y-4 leading-relaxed font-medium">
                                {% set ai_state = model.ai_executive_summary.get('current_state', 'Analysis Pending: API Capacity Exceeded. Rely on structural metrics for strategy execution.') %}
                                {% for paragraph in ai_state.split('\n') %}
                                    {% if paragraph.strip() %}
                                    <p>{{ paragraph }}</p>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>

                        <!-- 2. Critical Blockers -->
                        {% set ai_risks = model.ai_executive_summary.get('critical_risks') %}
                        {% if ai_risks %}
                        <div class="bg-red-500/5 border border-red-500/25 p-6 rounded-xl">
                            <h4 class="text-sm font-bold uppercase tracking-widest text-red-400 mb-4 flex items-center gap-2">
                                <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                                Critical Blockers
                            </h4>
                            <div class="text-sm text-gray-300 space-y-3 leading-relaxed">
                                {% for paragraph in ai_risks.split('\n') %}
                                    {% if paragraph.strip() %}
                                    <p>{{ paragraph }}</p>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}
                        
                        <!-- 3. Strategic Roadmap -->
                        {% set ai_roadmap = model.ai_executive_summary.get('strategic_roadmap') %}
                        {% if ai_roadmap %}
                        <div class="pt-8 border-t border-borderline">
                            <h4 class="text-sm font-bold uppercase tracking-widest text-emerald-400 mb-6">Strategic Roadmap</h4>
                            {% if ai_roadmap is string %}
                                <div class="text-base text-gray-300 space-y-4 leading-relaxed">
                                    {% for paragraph in ai_roadmap.split('\n') %}
                                        {% if paragraph.strip() %}
                                        <p>{{ paragraph }}</p>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% else %}
                                <!-- Render Premium Vertical Timeline -->
                                <div class="relative pl-6 border-l border-borderline space-y-8">
                                    {% for step in ai_roadmap %}
                                    <div class="relative">
                                        <!-- Step Badge -->
                                        <div class="absolute -left-[2.15rem] top-0 w-8 h-8 rounded-full bg-brand-500/10 border border-brand-500/30 flex items-center justify-center text-brand-400 text-sm font-black font-mono shadow-glow-brand">
                                            {{ step.step_number | default(loop.index) }}
                                        </div>
                                        <!-- Step Card -->
                                        <div class="bg-surface-50 border border-borderline p-5 rounded-xl ml-2 shadow-sm transition-all hover:border-brand-500/30">
                                            <h5 class="text-white font-bold text-base mb-2">{{ step.title }}</h5>
                                            <p class="text-sm text-gray-300 leading-relaxed mb-3">{{ step.description }}</p>
                                            {% if step.rationale %}
                                            <div class="text-xs bg-surface-100/50 p-2.5 rounded border border-borderline/50 text-themeMuted">
                                                <strong class="text-brand-400 font-bold uppercase tracking-wider text-[9px] block mb-1">Modernization Rationale</strong>
                                                {{ step.rationale }}
                                            </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                        {% endif %}
                    </div>
                </div>
            </section>

            <!-- ==========================================
                 2. ARCHITECTURAL DISCOVERY
                 ========================================== -->
            <section id="discovery" class="doc-section">
                <header class="mb-10">
                    <h2 class="text-4xl font-extrabold text-white tracking-tight mb-4">Architectural Discovery</h2>
                    <p class="text-gray-400 leading-relaxed max-w-4xl text-lg">Bridging the gap between raw physical files and inferred logical boundaries. Visualizing structural edges, monolith layout, and presentation vs logic separation.</p>
                </header>

                {% if model.layered_architecture %}
                
                <!-- Macro-Domain Dependency Graph -->
                <div class="bg-surface-100 border border-borderline rounded-2xl shadow-2xl flex flex-col relative overflow-hidden mb-12">
                    <div class="p-6 border-b border-borderline flex flex-col sm:flex-row justify-between sm:items-center gap-4 z-10 bg-surface-50">
                        <div>
                            <h3 class="text-white font-bold text-lg">System Topology (Node-Edge Graph)</h3>
                            <p class="text-xs text-gray-500 mt-1">Interactive visualization of module dependencies and coupling.</p>
                        </div>
                    </div>
                    <!-- 500px Height Canvas -->
                    <div id="topologyGraph" class="h-[500px] w-full bg-themeBg bg-gradient-mesh relative">
                        <!-- Graph will be injected here via Vis.js -->
                    </div>
                    <script>
                        document.addEventListener("DOMContentLoaded", function() {
                            {% if model.layered_architecture.system_topology %}
                            var rawNodes = {{ model.layered_architecture.system_topology.get('nodes', []) | tojson }};
                            var rawEdges = {{ model.layered_architecture.system_topology.get('edges', []) | tojson }};
                            
                            var nodes = new vis.DataSet(rawNodes.map(n => ({
                                id: n.id, label: n.label, color: n.color, size: n.size || 15,
                                font: { color: "#e0e0e0", face: "Inter", size: 12 },
                                shape: 'dot'
                            })));
                            
                            var edges = new vis.DataSet(rawEdges.map(e => ({
                                from: e.source, to: e.target, color: { color: "rgba(100, 100, 100, 0.5)" }, arrows: "to"
                            })));
                            
                            var container = document.getElementById('topologyGraph');
                            var data = { nodes: nodes, edges: edges };
                            var options = {
                                physics: {
                                    barnesHut: { gravitationalConstant: -2000, centralGravity: 0.3, springLength: 95, springConstant: 0.04 },
                                    stabilization: { iterations: 150 }
                                },
                                nodes: { borderWidth: 0 }
                            };
                            if (nodes.length > 0) {
                                new vis.Network(container, data, options);
                            } else {
                                container.innerHTML = '<div class="absolute inset-0 flex items-center justify-center"><span class="text-gray-500 font-mono text-sm">No topology edges detected.</span></div>';
                            }
                            {% endif %}
                        });
                    </script>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
                    <!-- Presentation vs Logic -->
                    <div class="bg-surface-100 border border-borderline rounded-2xl p-8 shadow-2xl flex flex-col justify-between">
                        <div>
                            <h3 class="text-white font-bold text-lg mb-2">Presentation vs. Logic</h3>
                            <p class="text-xs text-gray-500 mb-6">Assesses whether the codebase maintains a healthy separation of concerns.</p>
                            
                            <div class="space-y-5 mb-8">
                                <div>
                                    <div class="flex justify-between text-sm mb-2">
                                        <span class="text-gray-300">Presentation / UI Files</span> 
                                        <span class="text-white font-mono font-bold">{{ "%.1f"|format(model.layered_architecture.presentation_ratio) }}%</span>
                                    </div>
                                    <div class="w-full h-2 bg-surface-200 rounded-full overflow-hidden">
                                        <div class="h-full bg-brand-500 rounded-full shadow-glow-brand" style="width: {{ model.layered_architecture.presentation_ratio }}%"></div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="border-t border-borderline/50 pt-6 space-y-4">
                                <div>
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-gray-500 block mb-1">Separation Status</span>
                                    {% if model.layered_architecture.presentation_ratio > 60 %}
                                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-400 bg-red-500/10 px-2.5 py-1 rounded">
                                            <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Highly UI-Coupled (Critical Debt)
                                        </span>
                                    {% elif model.layered_architecture.presentation_ratio > 40 %}
                                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-400 bg-amber-500/10 px-2.5 py-1 rounded">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Procedural Monolith (Moderate Debt)
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Separated Concerns (Healthy)
                                        </span>
                                    {% endif %}
                                </div>
                                
                                <div>
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-gray-500 block mb-1">Architectural Impact</span>
                                    <p class="text-xs text-gray-300 leading-relaxed">
                                        {% if model.layered_architecture.presentation_ratio > 60 %}
                                            The user interface (views/templates) is heavily intertwined with the routing or database backend logic. Modernizing or decoupling logic into independent APIs requires first extracting database queries and business rules from the templates.
                                        {% elif model.layered_architecture.presentation_ratio > 40 %}
                                            Significant page templating and direct request handling are mixed within the codebase, indicating classic MVC logic sprawl. Decoupling routes will require clean controller segregation.
                                        {% else %}
                                            The codebase maintains a healthy separation of presentation templates from system backend business logic, making it easier to expose backend service endpoints.
                                        {% endif %}
                                    </p>
                                </div>
                                
                                <div>
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-gray-500 block mb-1">Modernization Action Item</span>
                                    <p class="text-xs text-gray-400 leading-relaxed italic">
                                        {% if model.layered_architecture.presentation_ratio > 50 %}
                                            Prioritize decoupling: extract inline queries and view generation into distinct controller routing files, transitioning to a clean JSON API interface before containerization.
                                        {% else %}
                                            Separation is manageable: focus on namespacing the backend business objects and wrapping them in automated unit tests.
                                        {% endif %}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Logical Domains Matrix -->
                    <div class="bg-surface-100 border border-borderline rounded-2xl shadow-2xl flex flex-col justify-between overflow-hidden">
                        <div>
                            <div class="p-6 border-b border-borderline flex justify-between items-center bg-surface-50">
                                <h3 class="text-white font-bold text-lg">Inferred Bounded Contexts</h3>
                            </div>
                            <div class="overflow-y-auto flex-1 max-h-60">
                                <table class="w-full data-table">
                                    <thead class="sticky top-0 z-10 bg-surface-200">
                                        <tr><th>Semantic Domain</th><th>Files</th><th>Coupling</th><th>State Sinks</th></tr>
                                    </thead>
                                    <tbody>
                                        {% for c in model.layered_architecture.bounded_contexts %}
                                        <tr>
                                            <td class="font-bold text-white flex items-center gap-3">
                                                <div class="w-2 h-2 {% if loop.index % 3 == 0 %}bg-emerald-500{% elif loop.index % 2 == 0 %}bg-purple-500{% else %}bg-brand-500{% endif %} rounded-full"></div> {{ c.name }}
                                            </td>
                                            <td class="font-mono text-xs">{{ c.file_count }}</td>
                                            <td>
                                                <span class="{% if c.coupling_ratio|float > 10.0 %}text-red-400 bg-red-500/10{% elif c.coupling_ratio|float > 2.0 %}text-amber-400 bg-amber-500/10{% else %}text-green-500 bg-green-500/10{% endif %} font-mono px-2 py-1 rounded text-xs">
                                                    {{ c.coupling_ratio }}
                                                </span>
                                            </td>
                                            <td>
                                                <div class="flex gap-2 text-[10px] font-bold uppercase tracking-widest">
                                                {% if c.db_access %}<span class="text-blue-400 bg-blue-500/10 border border-blue-500/20 px-2 rounded">DB</span>{% endif %}
                                                {% if c.auth_access %}<span class="text-orange-400 bg-orange-500/10 border border-orange-500/20 px-2 rounded">AUTH</span>{% endif %}
                                                </div>
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        <!-- Strategic Domain Extractability Panel -->
                        <div class="p-6 border-t border-borderline bg-surface-50 space-y-4">
                            {% set ns = namespace(best_candidate=none, best_coupling=999.0, tangled_core=none, max_coupling=0.0, db_domains=[], auth_domains=[]) %}
                            {% for c in model.layered_architecture.bounded_contexts %}
                                {% if c.name != "Global" and c.name != "Unknown" and c.name != "class" and c.name != "tmp" %}
                                    {% if c.coupling_ratio < ns.best_coupling and c.file_count >= 2 %}
                                        {% set ns.best_coupling = c.coupling_ratio %}
                                        {% set ns.best_candidate = c %}
                                    {% endif %}
                                    {% if c.coupling_ratio > ns.max_coupling %}
                                        {% set ns.max_coupling = c.coupling_ratio %}
                                        {% set ns.tangled_core = c %}
                                    {% endif %}
                                {% endif %}
                                {% if c.db_access %}
                                    {% set _ = ns.db_domains.append(c.name) %}
                                {% endif %}
                                {% if c.auth_access %}
                                    {% set _ = ns.auth_domains.append(c.name) %}
                                {% endif %}
                            {% endfor %}
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                                <div>
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-gray-500 block mb-1">Extraction Candidate (Low-Hanging Fruit)</span>
                                    {% if ns.best_candidate %}
                                        <div class="text-white font-bold text-sm mb-1">{{ ns.best_candidate.name }}</div>
                                        <p class="text-gray-400 leading-relaxed">
                                            With a low coupling ratio of <strong class="text-emerald-400 font-mono">{{ ns.best_candidate.coupling_ratio }}</strong> across {{ ns.best_candidate.file_count }} files, this domain has clean semantic boundaries and represents the most immediate candidate for service extraction.
                                        </p>
                                    {% else %}
                                        <p class="text-gray-400 italic">No isolated domains qualified as clear extraction candidates.</p>
                                    {% endif %}
                                </div>
                                
                                <div>
                                    <span class="text-[10px] font-bold uppercase tracking-wider text-gray-500 block mb-1">Tangled Core (High Coupling Risk)</span>
                                    {% if ns.tangled_core %}
                                        <div class="text-white font-bold text-sm mb-1">{{ ns.tangled_core.name }}</div>
                                        <p class="text-gray-400 leading-relaxed">
                                            This domain exhibits high coupling (<strong class="text-red-400 font-mono">{{ ns.tangled_core.coupling_ratio }}</strong>). It is deeply entangled with other contexts and must be refactored or decoupled incrementally rather than split outright.
                                        </p>
                                    {% else %}
                                        <p class="text-gray-400 italic">No highly coupled domain outlier was flagged.</p>
                                    {% endif %}
                                </div>
                            </div>
                            
                            {% if ns.db_domains or ns.auth_domains %}
                            <div class="border-t border-borderline/50 pt-4 text-xs">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-amber-500 block mb-1">State & Auth Boundary Alerts</span>
                                <p class="text-gray-400 leading-relaxed">
                                    {% if ns.db_domains %}
                                        Direct database access sinks detected: <span class="text-blue-400 font-mono">{{ ns.db_domains | join(', ') }}</span>.
                                    {% endif %}
                                    {% if ns.auth_domains %}
                                        Direct auth/session state dependencies: <span class="text-orange-400 font-mono">{{ ns.auth_domains | join(', ') }}</span>.
                                    {% endif %}
                                    These boundaries bypass core abstractions, making unified repositories or API clients necessary during decoupling.
                                </p>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                
                <!-- Macro function to render nested tree -->
                {% macro render_tree(node, path='') %}
                    {% for name, data in node.items()|sort %}
                        {% set full_path = path ~ '/' ~ name %}
                        {% set info = data.get('_info') %}
                        {% if info %}
                            {% set icon = '▼' %}
                            {% set icon_color = 'text-yellow-500' %}
                            {% if info.type == 'vendor' %}
                                {% set icon = '■' %}
                                {% set icon_color = 'text-gray-500' %}
                            {% elif info.type == 'entry_point' %}
                                {% set icon = '◆' %}
                                {% set icon_color = 'text-red-500' %}
                            {% elif info.type == 'asset' %}
                                {% set icon = '●' %}
                                {% set icon_color = 'text-emerald-500' %}
                            {% endif %}
                            
                            <details class="ml-4 mb-2" {% if path == '' %}open{% endif %}>
                                <summary class="cursor-pointer select-none mb-1 hover:text-white transition-colors">
                                    <span class="{{ icon_color }} mr-2">{{ icon }}</span>
                                    <span class="font-bold">{{ name }}/</span>
                                    <span class="text-gray-600 text-xs ml-2">[{{ info.type }}]</span>
                                </summary>
                                <div class="border-l border-dashed border-gray-700 ml-2 pl-3 py-1 space-y-1">
                                    {% for f in info.get('files', []) %}
                                        {% set f_name = f.name if f is mapping else f %}
                                        {% set f_role = f.role if f is mapping else 'file' %}
                                        
                                        {% set f_icon = '●' %}
                                        {% set f_color = 'text-gray-500' %}
                                        {% if f_role == 'entry_point' %}{% set f_icon = '◆' %}{% set f_color = 'text-red-500' %}
                                        {% elif f_role == 'controller' %}{% set f_icon = '◆' %}{% set f_color = 'text-blue-400' %}
                                        {% elif f_role == 'view' %}{% set f_icon = '●' %}{% set f_color = 'text-emerald-500' %}
                                        {% elif f_role == 'job' %}{% set f_icon = '⚙️' %}{% set f_color = '' %}
                                        {% elif f_role == 'vendor' %}{% set f_icon = '■' %}{% set f_color = 'text-gray-500' %}
                                        {% elif f_role == 'model' %}{% set f_icon = '📦' %}{% set f_color = '' %}
                                        {% elif f_role == 'schema' %}{% set f_icon = '💾' %}{% set f_color = '' %}
                                        {% endif %}
                                        
                                        <div class="text-xs text-gray-400 flex items-center gap-2">
                                            <span class="{{ f_color }}">{{ f_icon }}</span>
                                            <span>{{ f_name }}</span>
                                            <span class="text-gray-600">({{ f_role }})</span>
                                        </div>
                                    {% endfor %}
                                    {{ render_tree(data.get('_children', {}), full_path) }}
                                </div>
                            </details>
                        {% else %}
                            <details class="ml-4 mb-2" {% if path == '' %}open{% endif %}>
                                <summary class="cursor-pointer select-none font-bold hover:text-white transition-colors">
                                    {{ name }}/
                                </summary>
                                <div class="border-l border-dashed border-gray-700 ml-2 pl-3 py-1">
                                    {{ render_tree(data.get('_children', {}), full_path) }}
                                </div>
                            </details>
                        {% endif %}
                    {% endfor %}
                {% endmacro %}
                
                <div class="bg-surface-200 border border-borderline rounded-2xl p-6 font-mono shadow-2xl max-h-[600px] overflow-y-auto">
                    <h3 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-6">Monolith Navigator</h3>
                    {{ render_tree(model.layered_architecture.directory_tree) }}
                </div>
                
                {% else %}
                <div class="bg-surface-100 border border-borderline rounded-2xl p-12 text-center text-gray-500 italic shadow-2xl">
                    Architectural Discovery data is unavailable.
                </div>
                {% endif %}
            </section>

            <!-- ==========================================
                 3. BOUNDARY INTELLIGENCE
                 ========================================== -->
            <section id="boundary" class="doc-section">
                <header class="mb-10">
                    <h2 class="text-4xl font-extrabold text-white tracking-tight mb-4">Boundary Intelligence</h2>
                    <p class="text-gray-400 leading-relaxed max-w-4xl text-lg">Auditing the external surface area and structural integrity. Mapping UI Entanglement, Network Endpoints, and Vendor Dependencies.</p>
                </header>

                {% if model.boundary_intelligence %}
                <!-- Top-level KPI strip -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-red-500">{{ model.boundary_intelligence.kpis.get('Global UI Entanglement', '0%') }}</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Global UI Entanglement</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-amber-500">{{ model.boundary_intelligence.kpis.get('Fat Views (DB-Coupled UI)', 0) }}</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Fat Views</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-brand-400">{{ model.boundary_intelligence.kpis.get('Total Endpoints Detected', 0) }}</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Endpoints Detected</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-white">{{ model.boundary_intelligence.kpis.get('Vendor Files Scanned', 0) }}</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Vendor Files Scanned</div>
                    </div>
                </div>

                <div class="bg-surface-100 border border-borderline rounded-2xl overflow-hidden shadow-2xl mb-12">
                    <div class="p-6 md:p-8 border-b border-borderline bg-surface-50">
                        <h3 class="text-white font-bold text-xl tracking-tight">MVC Deficit Report (UI Entanglement)</h3>
                        <p class="text-sm text-gray-500 mt-1">Quantifies how deeply HTML is baked into backend business logic.</p>
                    </div>
                    <div class="overflow-x-auto max-h-96">
                        <table class="w-full data-table">
                            <thead class="sticky top-0 z-10 bg-surface-200">
                                <tr>
                                    <th class="w-1/2">File Path / Namespace</th>
                                    <th class="w-1/4">Logic Entanglement</th>
                                    <th class="w-1/4">Data Sinks</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for p in model.boundary_intelligence.presentation_coupling %}
                                <tr>
                                    <td class="font-mono text-brand-400">{{ p.file_path }}</td>
                                    <td>
                                        <div class="flex items-center gap-3">
                                            <div class="w-full max-w-[120px] h-1.5 bg-surface-200 rounded-full overflow-hidden border border-borderline">
                                                {% set bar_color = 'bg-red-500' if p.ui_entanglement_ratio > 70 else ('bg-amber-500' if p.ui_entanglement_ratio > 30 else 'bg-emerald-500') %}
                                                {% set glow_class = 'shadow-glow-red' if p.ui_entanglement_ratio > 70 else '' %}
                                                <div class="h-full {{ bar_color }} rounded-full {{ glow_class }}" style="width: {{ p.ui_entanglement_ratio }}%"></div>
                                            </div>
                                            <span class="font-mono text-xs text-white">{{ p.ui_entanglement_ratio }}%</span>
                                        </div>
                                    </td>
                                    <td class="font-mono {% if p.db_queries > 5 %}text-red-400{% elif p.db_queries > 0 %}text-amber-500{% else %}text-gray-500{% endif %} text-xs">
                                        {{ p.db_queries }} SQL Queries
                                    </td>
                                    <td>
                                        {% if p.is_fat_view %}
                                        <span class="px-2.5 py-1 bg-red-500/10 text-red-500 border border-red-500/20 rounded text-[10px] uppercase font-bold tracking-wider">Critical</span>
                                        {% elif p.db_queries > 0 %}
                                        <span class="px-2.5 py-1 bg-amber-500/10 text-amber-500 border border-amber-500/20 rounded text-[10px] uppercase font-bold tracking-wider">High</span>
                                        {% else %}
                                        <span class="px-2.5 py-1 bg-surface-200 text-gray-400 border border-borderline rounded text-[10px] uppercase font-bold tracking-wider">Safe</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- API Surface & Vendor Panels -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- API Surface -->
                    <div class="bg-surface-100 border border-borderline rounded-2xl shadow-2xl flex flex-col overflow-hidden">
                        <div class="p-6 border-b border-borderline bg-surface-50">
                            <h3 class="text-white font-bold text-lg">API Surface Intelligence</h3>
                            <p class="text-xs text-gray-500 mt-1">Automatically infers the 'front door' of the application.</p>
                        </div>
                        <div class="overflow-y-auto max-h-80">
                            <table class="w-full data-table">
                                <thead class="sticky top-0 z-10 bg-surface-200">
                                    <tr><th>Entry Point</th><th>Type</th></tr>
                                </thead>
                                <tbody>
                                    {% for a in model.boundary_intelligence.api_surface %}
                                    <tr>
                                        <td class="font-mono text-xs text-brand-400">{{ a.path }}</td>
                                        <td class="text-xs font-bold text-gray-300">{{ a.type }}</td>
                                    </tr>
                                    {% endfor %}
                                    {% if not model.boundary_intelligence.api_surface %}
                                    <tr><td colspan="2" class="text-center italic text-gray-500 py-4">No API endpoints detected.</td></tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Vendor Inventory -->
                    <div class="bg-surface-100 border border-borderline rounded-2xl shadow-2xl flex flex-col overflow-hidden">
                        <div class="p-6 border-b border-borderline bg-surface-50 flex items-center justify-between">
                            <div>
                                <h3 class="text-white font-bold text-lg">Vendor Inventory</h3>
                                <p class="text-xs text-gray-500 mt-1">Detects "Shadow IT" and third-party libraries.</p>
                            </div>
                            {% if model.boundary_intelligence.kpis.get('Vendor Files Scanned', 0) > 0 %}
                            <span class="bg-red-500/10 text-red-500 px-2 py-1 rounded text-[10px] font-mono border border-red-500/20 font-bold uppercase">Risk</span>
                            {% else %}
                            <span class="bg-emerald-500/10 text-emerald-500 px-2 py-1 rounded text-[10px] font-mono border border-emerald-500/20 font-bold uppercase">Managed</span>
                            {% endif %}
                        </div>
                        <div class="overflow-y-auto max-h-80">
                            <table class="w-full data-table">
                                <thead class="sticky top-0 z-10 bg-surface-200">
                                    <tr><th>Library/Plugin File</th><th>Vendor Type</th><th>Status</th></tr>
                                </thead>
                                <tbody>
                                    {% for v in model.boundary_intelligence.vendor_inventory %}
                                    <tr>
                                        <td class="font-mono text-[10px] text-gray-400 truncate max-w-[200px]" title="{{ v.file_path }}">{{ v.file_path }}</td>
                                        <td class="text-xs">{{ v.vendor_type }}</td>
                                        <td>
                                            {% if 'ORPHANED' in v.status|upper %}
                                            <span class="px-2 py-1 bg-red-500/10 text-red-400 border border-red-500/20 rounded text-[10px] uppercase font-bold">{{ v.status }}</span>
                                            {% elif 'COMPOSER' in v.vendor_type|upper %}
                                            <span class="px-2 py-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded text-[10px] uppercase font-bold">{{ v.status }}</span>
                                            {% else %}
                                            <span class="px-2 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/20 rounded text-[10px] uppercase font-bold">{{ v.status }}</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                    {% endfor %}
                                    {% if not model.boundary_intelligence.vendor_inventory %}
                                    <tr><td colspan="3" class="text-center italic text-gray-500 py-4">No vendor files detected.</td></tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="bg-surface-100 border border-borderline rounded-2xl p-12 text-center text-gray-500 italic shadow-2xl">
                    Boundary intelligence data is unavailable.
                </div>
                {% endif %}
            </section>

            <!-- ==========================================
                 4. DATABASE INTELLIGENCE
                 ========================================== -->
            <section id="database" class="doc-section">
                <header class="mb-10">
                    <h2 class="text-4xl font-extrabold text-white tracking-tight mb-4">Database Intelligence</h2>
                    <p class="text-gray-400 leading-relaxed max-w-4xl text-lg">Persistence Layer Analysis, CRUD Patterns, and Table Ownership.</p>
                </header>

                {% if model.database_intelligence %}
                <!-- KPIs -->
                {% set taxonomy = model.database_intelligence.taxonomy %}
                {% set total_reads = taxonomy.values() | map(attribute='reads') | sum %}
                {% set total_writes = taxonomy.values() | map(attribute='writes') | sum %}
                {% set total_orm = taxonomy.values() | map(attribute='orm') | sum %}
                {% set total_creds = taxonomy.values() | map(attribute='credentials') | sum %}

                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-brand-400">{{ total_reads }}</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Read Operations</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-brand-400">{{ total_writes }}</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Write Operations</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-emerald-500">{{ total_orm }}</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">ORM Abstractions</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black {% if total_creds > 0 %}text-red-500{% else %}text-emerald-500{% endif %}">{{ total_creds }}</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Credential Risks</div>
                    </div>
                </div>

                <!-- Access Taxonomy -->
                <div class="bg-surface-100 border border-borderline rounded-2xl overflow-hidden shadow-2xl mb-12">
                    <div class="p-6 md:p-8 border-b border-borderline bg-surface-50">
                        <h3 class="text-white font-bold text-xl tracking-tight">Access Taxonomy (CRUD Patterns)</h3>
                        <p class="text-sm text-gray-500 mt-1">Files ranked by their database interaction volume.</p>
                    </div>
                    <div class="overflow-x-auto max-h-96">
                        <table class="w-full data-table">
                            <thead class="sticky top-0 z-10 bg-surface-200">
                                <tr>
                                    <th>File</th>
                                    <th>Reads</th>
                                    <th>Writes</th>
                                    <th>ORM</th>
                                    <th>Transactions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for file, metrics in model.database_intelligence.taxonomy.items() %}
                                {% if metrics.reads > 0 or metrics.writes > 0 or metrics.orm > 0 %}
                                <tr>
                                    <td class="font-mono text-brand-400 text-xs">{{ file }}</td>
                                    <td class="font-mono text-white">{{ metrics.reads }}</td>
                                    <td class="font-mono text-white">{{ metrics.writes }}</td>
                                    <td class="font-mono text-white">{{ metrics.orm }}</td>
                                    <td class="font-mono text-white">{{ metrics.transactions }}</td>
                                </tr>
                                {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Table Ownership & Domain Model Mermaid -->
                <div class="grid grid-cols-1 xl:grid-cols-2 gap-8 mb-12">
                    <div class="bg-surface-100 border border-borderline rounded-2xl overflow-hidden shadow-2xl flex flex-col h-full">
                        <div class="p-6 border-b border-borderline bg-surface-50">
                            <h3 class="text-white font-bold text-lg tracking-tight">Table Ownership</h3>
                            <p class="text-xs text-gray-500 mt-1">Cross-module write conflicts.</p>
                        </div>
                        <div class="overflow-y-auto max-h-[400px] flex-grow">
                            <table class="w-full data-table">
                                <thead class="sticky top-0 z-10 bg-surface-200">
                                    <tr>
                                        <th>Table Name</th>
                                        <th>Primary Owner</th>
                                        <th>Cross-Module Conflict</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in model.database_intelligence.table_ownership %}
                                    <tr>
                                        <td class="font-mono text-white font-bold text-xs">{{ row.table }}</td>
                                        <td class="text-gray-300 text-xs">{{ row.primary_owner }}</td>
                                        <td>
                                            {% if row.cross_module_write %}
                                            <span class="px-2 py-1 bg-red-500/10 text-red-400 border border-red-500/20 rounded text-[10px] uppercase font-bold">Conflict</span>
                                            {% else %}
                                            <span class="px-2 py-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded text-[10px] uppercase font-bold">Safe</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                    <div class="bg-surface-100 border border-borderline rounded-2xl overflow-hidden shadow-2xl flex flex-col h-full">
                        <div class="p-6 border-b border-borderline bg-surface-50">
                            <h3 class="text-white font-bold text-lg tracking-tight">Inferred Domain Model</h3>
                            <p class="text-xs text-gray-500 mt-1">Behavioral table relationships.</p>
                        </div>
                        <div class="p-6 flex-grow flex items-center justify-center overflow-auto min-h-[400px]">
                            <div class="mermaid">
                            graph TD
                            {% for rel in model.database_intelligence.erd_relationships %}
                            {% set a = rel.from | replace('-', '_') | replace('.', '_') | replace('/', '_') %}
                            {% set b = rel.to | replace('-', '_') | replace('.', '_') | replace('/', '_') %}
                            {{ a }}["{{ rel.from }}"] ---|{{ rel.inferred_via }}| {{ b }}["{{ rel.to }}"]
                            {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
                
                {% else %}
                <div class="bg-surface-100 border border-borderline rounded-2xl p-12 text-center text-gray-500 italic shadow-2xl">
                    Database intelligence data is unavailable.
                </div>
                {% endif %}
            </section>
            
            <!-- ==========================================
                 5. GLOBAL STATE INTELLIGENCE
                 ========================================== -->
            <section id="global_state" class="doc-section">
                <header class="mb-10">
                    <h2 class="text-4xl font-extrabold text-white tracking-tight mb-4">Runtime & Global State</h2>
                    <p class="text-gray-400 leading-relaxed max-w-4xl text-lg">Superglobal Tracking, Session Flows, and Side-Effect Classification.</p>
                </header>

                {% if model.global_state_intelligence %}
                {% set totals = model.global_state_intelligence.superglobal_totals %}
                {% set sg_hits = totals.values() | sum %}
                {% set total_mutations = model.global_state_intelligence.superglobal_mutations | length %}
                
                <!-- KPIs -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-red-400">{{ sg_hits }}</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Superglobal Hits</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-amber-500">{{ total_mutations }}</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">State Mutations</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-brand-400">{{ model.global_state_intelligence.session_writers | length }}</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Session Writers</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-white">{{ model.global_state_intelligence.side_effect_totals.get('DANGER', 0) }}</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Danger Sinks</div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
                    <div class="bg-surface-100 border border-borderline rounded-2xl overflow-hidden shadow-2xl">
                        <div class="p-6 border-b border-borderline bg-surface-50">
                            <h3 class="text-white font-bold text-lg tracking-tight">Superglobal Usage Distribution</h3>
                        </div>
                        <div class="p-6">
                            <div class="flex flex-wrap gap-3">
                                {% for var, count in model.global_state_intelligence.superglobal_totals.items() %}
                                <div class="px-4 py-2 bg-surface-50 border border-borderline rounded-lg flex items-center gap-3">
                                    <span class="font-mono text-brand-400 font-bold">${{ var }}</span>
                                    <span class="text-xs text-gray-400">{{ count }} hits</span>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    <div class="bg-surface-100 border border-borderline rounded-2xl overflow-hidden shadow-2xl">
                        <div class="p-6 border-b border-borderline bg-surface-50">
                            <h3 class="text-white font-bold text-lg tracking-tight">Side-Effect Breakdown</h3>
                        </div>
                        <div class="p-6">
                            <div class="flex flex-wrap gap-3">
                                {% for effect, count in model.global_state_intelligence.side_effect_totals.items() %}
                                {% if count > 0 %}
                                <div class="px-4 py-2 bg-surface-50 border border-borderline rounded-lg flex items-center gap-3">
                                    <span class="font-mono text-amber-500 font-bold">{{ effect }}</span>
                                    <span class="text-xs text-gray-400">{{ count }} ops</span>
                                </div>
                                {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
                
                {% else %}
                <div class="bg-surface-100 border border-borderline rounded-2xl p-12 text-center text-gray-500 italic shadow-2xl">
                    Global state intelligence data is unavailable.
                </div>
                {% endif %}
            </section>

            <!-- ==========================================
                 6. LEGACY PHP INTELLIGENCE
                 ========================================== -->
            <section id="legacy" class="doc-section">
                <header class="mb-10">
                    <h2 class="text-4xl font-extrabold text-white tracking-tight mb-4">Legacy PHP Intelligence</h2>
                    <p class="text-gray-400 leading-relaxed max-w-4xl text-lg">Era Classification, Anti-Pattern Detection, and Modernization Scoring.</p>
                </header>

                {% if model.legacy_intelligence %}
                <!-- KPIs -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-xl font-black text-white truncate px-2" title="{{ model.legacy_intelligence.classified_era }}">{{ model.legacy_intelligence.classified_era.split('(')[0].strip() }}</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">PHP Era</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-brand-400">{{ (model.legacy_intelligence.score_dimensions.get('Total Modernization Score', 0) * 100) | round(1) }}%</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Modernization Score</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-amber-500">{{ (model.legacy_intelligence.procedural_ratio * 100) | round(1) }}%</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Procedural Ratio</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-5 rounded-xl text-center shadow-lg">
                        <div class="text-2xl font-black text-emerald-500">{{ (model.legacy_intelligence.namespace_ratio * 100) | round(1) }}%</div>
                        <div class="text-[10px] text-gray-500 uppercase mt-1 font-mono">Namespace Coverage</div>
                    </div>
                </div>

                <div class="bg-surface-100 border border-borderline rounded-2xl overflow-hidden shadow-2xl mb-12">
                    <div class="p-6 md:p-8 border-b border-borderline bg-surface-50">
                        <h3 class="text-white font-bold text-xl tracking-tight">Legacy Anti-Pattern Inventory</h3>
                        <p class="text-sm text-gray-500 mt-1">Dangerous and depreciated patterns driving modernization complexity.</p>
                    </div>
                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {% for pattern, count in model.legacy_intelligence.pattern_totals.items() %}
                        {% if count > 0 %}
                        <div class="bg-surface-100 p-5 rounded-xl border border-borderline relative overflow-hidden group hover:border-red-500/30 transition-colors">
                            <div class="text-red-400 font-mono font-bold text-lg mb-2 relative z-10">{{ pattern }}</div>
                            <div class="flex items-end justify-between relative z-10">
                                <span class="text-gray-500 text-xs">Total Occurrences</span>
                                <span class="text-2xl font-black text-white">{{ count }}</span>
                            </div>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>

                {% else %}
                <div class="bg-surface-100 border border-borderline p-12 text-center text-gray-500 italic shadow-2xl">
                    Legacy intelligence data is unavailable.
                </div>
                {% endif %}
            </section>

            <!-- ==========================================
                 7. STRUCTURAL RISK AUDIT
                 ========================================== -->
            <section id="risks" class="doc-section">
                <header class="mb-10">
                    <h2 class="text-4xl font-extrabold text-white tracking-tight mb-4">Structural Risk Audit</h2>
                    <p class="text-gray-400 leading-relaxed max-w-4xl text-lg">Deep-dive SARIF-style findings for critical architectural blockers. Focuses on security sinks and modernization incompatibilities.</p>
                </header>

                {% for f in model.findings %}
                <div class="bg-surface-100 border border-borderline rounded-2xl shadow-2xl overflow-hidden mb-8">
                    <!-- Card Header -->
                    <div class="p-8 border-b border-borderline bg-surface-50 flex flex-col md:flex-row md:items-center justify-between gap-6">
                        <div class="flex items-center gap-5">
                            <div class="w-12 h-12 rounded-xl {% if f.priority == 'Critical' %}bg-red-500/10 border-red-500/30{% else %}bg-amber-500/10 border-amber-500/30{% endif %} border flex items-center justify-center shrink-0">
                                <svg class="w-6 h-6 {% if f.priority == 'Critical' %}text-red-500{% else %}text-amber-500{% endif %}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                            </div>
                            <div>
                                <h3 class="text-2xl font-bold text-white tracking-tight">{{ f.observation }}</h3>
                                <p class="text-gray-500 text-sm mt-1">Identified during static structural audit.</p>
                            </div>
                        </div>
                        <div class="flex gap-3 shrink-0">
                            <span class="px-3 py-1.5 bg-themeBg border border-borderline text-gray-400 rounded text-xs font-mono font-bold">Severity: {% if f.priority == 'Critical' %}CRITICAL{% else %}HIGH{% endif %}</span>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-8 grid grid-cols-1 lg:grid-cols-2 gap-10">

                        <!-- Left: Narrative -->
                        <div class="space-y-8">
                            <div>
                                <h4 class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-3 border-b border-borderline pb-2">Business & Security Impact</h4>
                                <p class="text-sm text-gray-300 leading-relaxed">{{ f.impact }}</p>
                            </div>
                            <div>
                                <h4 class="text-xs font-bold uppercase tracking-widest text-brand-400 mb-3 border-b border-brand-500/20 pb-2">Remediation Action</h4>
                                <p class="text-sm text-gray-300 leading-relaxed">{{ f.recommended_action }}</p>
                            </div>
                        </div>

                        <!-- Right: Evidence & Topology -->
                        <div class="space-y-6 flex flex-col">
                            <!-- Code Snippet -->
                            <div>
                                <div class="flex justify-between items-center bg-surface-50 px-4 py-2 border border-borderline border-b-0 rounded-t-lg">
                                    <span class="text-xs font-mono text-themeMuted truncate max-w-sm" title="{% for ev in f.evidence %}{% if loop.first %}{{ ev.target }}{% endif %}{% endfor %}">
                                        {% for ev in f.evidence %}
                                            {% if loop.first %}{{ ev.target }}{% endif %}
                                        {% endfor %}
                                    </span>
                                </div>
                                <div class="code-block rounded-t-none border-t-0 bg-themeBg m-0 text-brand-400">
                                    // Primary Target Code Path
                                    {% for ev in f.evidence %}
                                        {% if loop.first %}{{ ev.target }}{% endif %}
                                    {% endfor %}
                                </div>
                            </div>

                            <!-- Mermaid Diagram -->
                            {% if f.mermaid_diagram %}
                            <div class="flex-1 bg-themeBg border border-borderline rounded-lg p-6 flex flex-col items-center justify-center min-h-[200px] overflow-x-auto">
                                <span class="text-[10px] uppercase text-gray-600 tracking-widest font-bold self-start mb-4">Topology Fragment</span>
                                <div class="w-full flex justify-center">
                                    <pre class="mermaid text-center">{{ f.mermaid_diagram }}</pre>
                                </div>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="bg-surface-100 border border-borderline rounded-2xl p-12 text-center text-gray-500 italic shadow-2xl">
                    No critical structural risks identified.
                </div>
                {% endfor %}
            </section>

            <!-- ==========================================
            <!-- ==========================================
                 8. STRATEGIC ADVISORY
                 ========================================== -->
            <section id="playbooks" class="doc-section border-b-0 pb-16">
                <header class="mb-14">
                    <h2 class="text-4xl font-extrabold text-white tracking-tight mb-4">Strategic Advisory</h2>
                    <p class="text-gray-400 leading-relaxed max-w-4xl text-lg">Modernization Decision Engine recommendations, Actionable ROI matrices, and execution playbooks based on architectural complexity.</p>
                </header>

                {% if model.strategic_advisory %}
                {% set kpis = model.strategic_advisory.get('kpis', {}) %}
                {% set recommendations = model.strategic_advisory.get('recommendations', []) %}
                
                <!-- Decision Engine KPIs -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                    <div class="bg-surface-100 border border-borderline p-6 rounded-2xl shadow-xl text-center">
                        <div class="text-3xl font-black text-brand-400 mb-2">{{ kpis.get('Overall Migration Effort', 'N/A') }}</div>
                        <div class="text-xs text-gray-500 uppercase tracking-widest font-bold">Estimated Effort</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-6 rounded-2xl shadow-xl text-center">
                        <div class="text-3xl font-black text-white mb-2">{{ kpis.get('Most Common Strategy', 'N/A') }}</div>
                        <div class="text-xs text-gray-500 uppercase tracking-widest font-bold">Primary Path</div>
                    </div>
                    <div class="bg-surface-100 border border-borderline p-6 rounded-2xl shadow-xl text-center">
                        <div class="text-3xl font-black text-emerald-500 mb-2">{{ kpis.get('High Value Targets', 0) }}</div>
                        <div class="text-xs text-gray-500 uppercase tracking-widest font-bold">Quick Wins (High ROI)</div>
                    </div>
                </div>

                <!-- Modernization ROI Table -->
                <div class="bg-surface-100 border border-borderline rounded-2xl overflow-hidden shadow-2xl mb-16">
                    <div class="p-6 md:p-8 border-b border-borderline bg-surface-50 flex justify-between items-center">
                        <div>
                            <h3 class="text-white font-bold text-xl tracking-tight">Modernization ROI Matrix</h3>
                            <p class="text-sm text-gray-500 mt-1">Cost-benefit analysis of modernizing each architectural module.</p>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full data-table text-sm min-w-[800px]">
                            <thead class="bg-surface-200">
                                <tr>
                                    <th>Module Context</th>
                                    <th>Recommended Strategy</th>
                                    <th>ROI Score</th>
                                    <th>Migration Effort</th>
                                    <th>Primary Blocker</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for rec in recommendations %}
                                <tr>
                                    <td class="font-bold text-white">{{ rec.Context }}</td>
                                    <td>
                                        {% if rec['Recommended Strategy'] == 'EXTRACT (MICROSERVICE)' %}
                                        <span class="px-2 py-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded text-[10px] font-bold">EXTRACT</span>
                                        {% elif rec['Recommended Strategy'] == 'REWRITE' %}
                                        <span class="px-2 py-1 bg-red-500/10 text-red-400 border border-red-500/20 rounded text-[10px] font-bold">REWRITE</span>
                                        {% elif rec['Recommended Strategy'] == 'STRANGLER FIG' %}
                                        <span class="px-2 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/20 rounded text-[10px] font-bold">STRANGLER FIG</span>
                                        {% elif rec['Recommended Strategy'] == 'REPLATFORM' %}
                                        <span class="px-2 py-1 bg-brand-500/10 text-brand-400 border border-brand-500/20 rounded text-[10px] font-bold">REPLATFORM</span>
                                        {% else %}
                                        <span class="px-2 py-1 bg-gray-500/10 text-gray-400 border border-gray-500/20 rounded text-[10px] font-bold">{{ rec['Recommended Strategy'] }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="flex items-center gap-2">
                                            <div class="w-16 h-2 bg-surface rounded overflow-hidden">
                                                <div class="h-full bg-emerald-500" style="width: {{ rec['Modernization ROI'] }}%"></div>
                                            </div>
                                            <span class="font-mono text-gray-300">{{ rec['Modernization ROI'] }}</span>
                                        </div>
                                    </td>
                                    <td class="font-mono text-gray-400">{{ rec['Migration Effort'] }}</td>
                                    <td class="text-gray-400 italic">{{ rec['Primary Blocker'] }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                {% endif %}

                <!-- AI Architectural Intelligence (Deep Insights) -->
                {% if model.ai_executive_summary and model.ai_executive_summary.get('findings') %}
                <div class="mb-16">
                    <h3 class="text-2xl font-bold text-white mb-6">Deep AI Architectural Intelligence</h3>
                    <div class="space-y-6">
                        {% for finding in model.ai_executive_summary.get('findings', []) %}
                        <div class="bg-surface-100 border border-borderline p-8 rounded-2xl shadow-xl flex flex-col xl:flex-row gap-8">
                            <div class="flex-1 space-y-4">
                                <div class="flex items-center gap-3 mb-2">
                                    {% if finding.priority == 'Critical' %}
                                    <span class="px-2 py-0.5 bg-red-500/10 text-red-500 border border-red-500/30 rounded text-xs font-bold uppercase">CRITICAL</span>
                                    {% else %}
                                    <span class="px-2 py-0.5 bg-amber-500/10 text-amber-500 border border-amber-500/30 rounded text-xs font-bold uppercase">HIGH</span>
                                    {% endif %}
                                    <h4 class="text-xl font-bold text-white">{{ finding.observation }}</h4>
                                </div>
                                <div class="text-sm text-gray-400 leading-relaxed border-l-2 border-borderline pl-4">
                                    <p class="font-bold text-gray-300 mb-1">Impact:</p>
                                    {{ finding.impact }}
                                </div>
                                <div class="text-sm text-brand-100 leading-relaxed bg-brand-500/5 p-4 rounded-lg border border-brand-500/20">
                                    <p class="font-bold text-brand-400 mb-1">Executive Recommendation:</p>
                                    {{ finding.recommended_action }}
                                </div>
                            </div>
                            
                            {% if finding.mermaid_diagram %}
                            <div class="xl:w-[400px] shrink-0 bg-themeBg rounded-xl border border-borderline p-4 flex items-center justify-center min-h-[250px] overflow-auto">
                                <div class="mermaid">
                                {{ finding.mermaid_diagram }}
                                </div>
                            </div>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <!-- Executive Roadmap Timeline -->
                <div class="relative border-l-2 border-borderline ml-3 md:ml-6 space-y-16">
                    {% set roadmap = model.ai_executive_summary.get('strategic_roadmap', 'Execute architectural decoupling based on boundary data.') %}
                    <div class="relative pl-10 md:pl-12">
                        <div class="absolute w-5 h-5 bg-brand-500 rounded-full -left-[10.5px] top-1 border-[4px] border-themeBg shadow-[0_0_15px_rgba(59,130,246,0.8)]"></div>
                        <div class="flex flex-col md:flex-row md:items-center gap-4 mb-4">
                            <span class="text-brand-500 font-mono text-sm uppercase tracking-widest font-extrabold bg-brand-500/10 border border-brand-500/20 px-3 py-1 rounded inline-block w-max">Extraction Playbook</span>
                        </div>
                        <h3 class="text-3xl font-bold text-white mb-4">Phased Execution</h3>
                        <p class="text-base text-gray-400 mb-8 leading-relaxed max-w-4xl whitespace-pre-wrap">{{ roadmap }}</p>

                        <div class="bg-surface-100 border border-borderline rounded-xl overflow-hidden shadow-2xl max-w-4xl">
                            <div class="p-4 border-b border-borderline bg-surface-200 flex gap-2">
                                <div class="w-3 h-3 rounded-full bg-red-500/20 border border-red-500/50"></div>
                                <div class="w-3 h-3 rounded-full bg-amber-500/20 border border-amber-500/50"></div>
                                <div class="w-3 h-3 rounded-full bg-green-500/20 border border-green-500/50"></div>
                            </div>
                            <div class="p-6 text-sm font-mono text-gray-300 space-y-4 bg-themeBg">
                                <div class="flex group"><span class="w-8 shrink-0 text-brand-500">01</span> <span class="group-hover:text-white transition-colors">Target Quick Wins: Extract highly cohesive, low-effort modules.</span></div>
                                <div class="flex group"><span class="w-8 shrink-0 text-brand-500">02</span> <span class="group-hover:text-white transition-colors">Wrap tangled business logic with anti-corruption layers.</span></div>
                                <div class="flex group"><span class="w-8 shrink-0 text-brand-500">03</span> <span class="group-hover:text-white transition-colors">Execute Strangler Fig pattern for core structural rewrites.</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

        </main>
    </div>

    <!-- Data Visualization Initialization -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Chart.js Global Config for Dark Mode
            Chart.defaults.color = '#737373';
            Chart.defaults.font.family = 'Inter';

            // 1. Readiness Doughnut Gauge
            const readinessEl = document.getElementById('readinessChart');
            if (readinessEl) {
                const ctxDoughnut = readinessEl.getContext('2d');
                {% set score = model.system_context.overall_readiness %}
                {% set color = '#10b981' if score > 60 else ('#f59e0b' if score > 30 else '#ef4444') %}
                new Chart(ctxDoughnut, {
                    type: 'doughnut',
                    data: { datasets: [{ data: [{{ score }}, {{ 100 - score }}], backgroundColor: ['{{ color }}', '#111'], borderWidth: 0 }] },
                    options: {
                        cutout: '85%', responsive: true, maintainAspectRatio: false,
                        plugins: { tooltip: { enabled: false } },
                        rotation: -90, circumference: 180,
                        animation: { animateScale: true, animateRotate: true }
                    }
                });
            }

            // 2. Architecture Radar Chart
            {% if model.legacy_intelligence and model.legacy_intelligence.score_dimensions %}
            const ctxRadar = document.getElementById('radarChart').getContext('2d');
            const getChartColors = () => {
                const isL = document.body.classList.contains('light-theme');
                return {
                    grid: isL ? '#d1d5db' : '#262626',
                    angle: isL ? '#d1d5db' : '#262626',
                    labels: isL ? '#374151' : '#a3a3a3',
                    bg: isL ? 'rgba(59, 130, 246, 0.15)' : 'rgba(59, 130, 246, 0.2)'
                };
            };
            
            let colors = getChartColors();
            const radarChart = new Chart(ctxRadar, {
                type: 'radar',
                data: {
                    labels: ['Security', 'Coupling', 'Testability', 'Namespace', 'Complexity', 'DB Layer'],
                    datasets: [{
                        label: 'Current State',
                        data: [
                            {{ (model.legacy_intelligence.score_dimensions.get('Security Score', 0) * 10) | round(1) }},
                            {{ (model.legacy_intelligence.score_dimensions.get('Coupling Score', 0) * 10) | round(1) }},
                            {{ (model.legacy_intelligence.score_dimensions.get('Testability Score', 0) * 10) | round(1) }},
                            {{ (model.legacy_intelligence.score_dimensions.get('Namespace Score', 0) * 10) | round(1) }},
                            {{ [0, 10 - (model.system_context.avg_complexity / 10)] | max | round(1) }},
                            {{ (model.legacy_intelligence.score_dimensions.get('DB Layer Score', 0) * 10) | round(1) }}
                        ],
                        backgroundColor: colors.bg,
                        borderColor: '#3b82f6',
                        pointBackgroundColor: '#3b82f6',
                        pointBorderColor: '#fff',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    scales: {
                        r: {
                            min: 0, max: 10,
                            ticks: { display: false },
                            grid: { color: colors.grid },
                            angleLines: { color: colors.angle },
                            pointLabels: { color: colors.labels, font: { size: 10, weight: '600' } }
                        }
                    },
                    plugins: { legend: { display: false } }
                }
            });

            window.addEventListener('theme-changed', () => {
                const newColors = getChartColors();
                radarChart.data.datasets[0].backgroundColor = newColors.bg;
                radarChart.options.scales.r.grid.color = newColors.grid;
                radarChart.options.scales.r.angleLines.color = newColors.angle;
                radarChart.options.scales.r.pointLabels.color = newColors.labels;
                radarChart.update();
            });
            {% endif %}
        });
    </script>
</body>
</html>
